# ─── Backend Docker Build Exclusions ─────────────────────────────────────────

# Secrets — never bake into image
.env
.env.local

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Logs and runtime outputs
*.log
twilio_relay.log

# Audio sample files (test artifacts)
*.mp3

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
