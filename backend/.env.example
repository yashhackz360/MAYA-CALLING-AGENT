# ════════════════════════════════════════════════════════════
# MantaRay AI — Škoda Customer Care Agent · Environment Config
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# Stack: Twilio (outbound PSTN) + ElevenLabs Conversational Agent

# ─── REQUIRED: ElevenLabs Conversational AI ───────────────────────────────────
# 1. Go to https://elevenlabs.io/app/conversational-ai
# 2. Create or open your Agent → copy the Agent ID from the Agent settings tab
ELEVENLABS_AGENT_ID=

# 3. Go to https://elevenlabs.io/app/settings/api-keys → create a key and paste below
ELEVENLABS_API_KEY=

# ─── REQUIRED: Twilio (Outbound Calling) ──────────────────────────────────────
# 4. https://console.twilio.com → Dashboard → copy Account SID and Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# 5. Your Twilio phone number in E.164 format (e.g. +14155551234)
TWILIO_FROM_NUMBER=

# 6. Public HTTPS URL of this backend so Twilio can POST to /twilio/voice.
#    Run: ngrok http 8000  →  copy the https URL here.
#    Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# ─── OPTIONAL: xAI Grok (Post-call AI analysis) ──────────────────────────────
# Get your API key at: https://console.x.ai/
XAI_API_KEY=

# ─── OPTIONAL: Razorpay (Billing page) ────────────────────────────────────────
# Get credentials at: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
